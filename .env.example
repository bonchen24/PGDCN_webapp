# Author: Gemini
# OS support: Web/Node
# Description: Example environment configuration for the active PCN Next.js app

PORT=1357
APP_PROFILE=pcn
OCR_SERVICE_URL=http://127.0.0.1:8100
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<Supabase POSTGRES_PASSWORD>
PCN_POSTGRES_DB=pcn_certification
PCN_DATABASE_URL=
SUPABASE_STORAGE_URL=http://127.0.0.1:8000/storage/v1
SUPABASE_SERVICE_ROLE_KEY=<Supabase service role key for private PCN Storage>
PCN_STORAGE_BUCKET=pcn-files
PCN_FILE_MAX_BYTES=26214400
PCN_DOCX_PDF_RENDERER=soffice
PCN_DOCX_PDF_RENDERER_TIMEOUT_MS=120000
PCN_SESSION_SECRET=<long random secret for PCN HttpOnly sessions>
# JSON array of room-app adapters; each secretEnv names a separately injected server secret.
# Example shape for the Docker network (use real deployment env only; never commit secrets):
# PERFORMANCE is served by LABFTEE_APP; DDT serves the EMC and electrical-safety routes.
# PCN_LAB_INTEGRATIONS_JSON=[{"systemCode":"PERFORMANCE","baseUrl":"http://labftee-app-prod:2358","secretEnv":"PCN_LAB_PERFORMANCE_SECRET"},{"systemCode":"EMC","baseUrl":"http://ddt_webapp-webapp:2359","secretEnv":"PCN_LAB_DDT_SECRET"},{"systemCode":"ELECTRICAL_SAFETY","baseUrl":"http://ddt_webapp-webapp:2359","secretEnv":"PCN_LAB_DDT_SECRET"}]
PCN_LAB_INTEGRATIONS_JSON=
PCN_LAB_PERFORMANCE_SECRET=
PCN_LAB_DDT_SECRET=
PCN_LAB_INTEGRATION_TIMEOUT_MS=10000
PCN_LAB_WEBHOOK_REPLAY_WINDOW_SECONDS=300
PCN_SMOKE_BASE_URL=http://localhost:1357
PCN_SMOKE_USERNAME=admin
PCN_SMOKE_PASSWORD=<temporary smoke account password; never pass on the command line>

GEMINI_API_KEY=

# Manual server-side database backups only (requires pg_dump/pg_restore on PATH)
BACKUP_ENABLED=false
BACKUP_RETENTION_COUNT=3
BACKUP_MAX_TOTAL_BYTES=2147483648

# --- End of .env.example ---
