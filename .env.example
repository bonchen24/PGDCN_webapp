# Author: Gemini
# OS support: Web/Node
# Description: Example environment configuration

PORT=1359
OCR_SERVICE_URL=http://127.0.0.1:8100
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<Supabase POSTGRES_PASSWORD>
POSTGRES_DB=ddt_lab
GEMINI_API_KEY=

# Automatic server-side database backups (requires pg_dump/pg_restore on PATH)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

# --- End of .env.example ---
