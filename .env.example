# Author: Gemini
# OS support: Web/Node
# Description: Example environment configuration

PORT=1359
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=ddt_admin
POSTGRES_PASSWORD=ddt_dev_password
POSTGRES_DB=ddt_lab
GEMINI_API_KEY=

# Automatic server-side database backups (requires pg_dump/pg_restore on PATH)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

