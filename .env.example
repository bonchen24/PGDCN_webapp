# Author: Gemini
# OS support: Web/Node
# Description: Example environment configuration

PORT=1357
OCR_SERVICE_URL=http://127.0.0.1:8100
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<Supabase POSTGRES_PASSWORD>
POSTGRES_DB=ddt_lab

# PCN profile: use these values with docker-compose.pcn.yml or local PCN development.
# APP_PROFILE=pcn
# PCN_POSTGRES_DB=pcn_certification
# PCN_DATABASE_URL=
# SUPABASE_STORAGE_URL=http://127.0.0.1:8000/storage/v1
# SUPABASE_SERVICE_ROLE_KEY=<Supabase service role key for private PCN Storage>
# PCN_STORAGE_BUCKET=ddt-files
# PCN_FILE_MAX_BYTES=26214400
# PCN_DOCX_PDF_RENDERER=soffice
# PCN_DOCX_PDF_RENDERER_TIMEOUT_MS=120000
# PCN_SESSION_SECRET=<long random secret for PCN HttpOnly sessions>
# PCN_SMOKE_BASE_URL=http://localhost:1357
# PCN_SMOKE_USERNAME=admin
# PCN_SMOKE_PASSWORD=<temporary smoke account password; never pass on the command line>

# PCN AI Agent (server-side only; never send a provider key from the browser)
# AGENT_ENABLED=false
# AGENT_PROVIDER=gemini
# AGENT_MODEL=gemini-flash-latest
GEMINI_API_KEY=

# Automatic server-side database backups (requires pg_dump/pg_restore on PATH)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

# --- End of .env.example ---
