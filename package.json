    "@xyflow/react": "^12.12.1",
    "adm-zip": "^0.6.0",
    "basic-ftp": "^6.2.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "date-fns": "^3.6.0",
    "docxtemplater": "3.49.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^17.4.2",
    "emf-to-png": "^0.1.0",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "lucide-react": "0.344.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "next": "^16.3.7",
    "pdf-lib": "^1.17.1",
