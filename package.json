    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "redis": "^6.3.1",
    "sonner": "1.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/cheerio": "^1.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/image-size": "^0.8.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.1",
    "saxes": "6.0.0",
    "tsx": "^4.22.5",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "docxtemplater-image-module-free": {
      "xmldom": "npm:@xmldom/xmldom@0.8.15"
    },
    "lucide-react": {
      "react": "$react"
    },
    "sonner": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "use-sync-external-store": {
      "react": "$react"
    },
    "cmdk": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
