{
  "name": "pcn-certification-tvci",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/run-next-dev.cjs",
    "dev:pcn": "node ./scripts/run-next-dev.cjs",
    "dev:next": "node ./scripts/run-next-dev.cjs",
    "build": "next build --webpack",
    "start": "node ./scripts/run-next-start.cjs",
    "start:next": "node ./scripts/run-next-start.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:pcn",
    "test:pcn": "node ./scripts/run-pcn-tests.cjs",
    "test:all": "node --require ./scripts/native-dev-preload.cjs ./node_modules/tsx/dist/cli.mjs --test",
    "test:redis-cache:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-redis-cache-integration.ps1",
    "qa:dossier": "node ./scripts/qa-dossier.mjs",
    "qa:dossier:mock": "node --test --test-concurrency=1 ./test/pcn-d10-detail-scope.playwright.test.mjs ./test/pgd-dossier-detail-density.playwright.test.mjs ./test/pcn-pgd-dossier-wheel-scroll.playwright.test.mjs",
    "test:qa:dossier-harness": "node --test --test-concurrency=1 ./test/qa-dossier-harness.test.mjs ./test/qa-dossier-auth.playwright.test.mjs",
    "migrate:json": "tsx scripts/importBackupToPostgres.ts",
    "migrate:pcn-customers": "node ./scripts/run-pcn-tsx.cjs scripts/migratePcnCustomers.ts",
    "import:pcn-template": "node ./scripts/run-pcn-tsx.cjs scripts/importPcnTemplate.ts",
    "smoke:pcn-runtime": "node ./scripts/run-pcn-tsx.cjs scripts/smokePcnRuntime.ts",
    "migrate:pcn-workflow": "node ./scripts/run-pcn-tsx.cjs scripts/migratePcnWorkflowSnapshots.ts",
    "test:pcn-docx-sources": "node ./scripts/run-pcn-tsx.cjs scripts/testPcnOperationalDocxAgainstSources.ts",
    "verify:pcn-standard-flow": "node ./scripts/run-pcn-tsx.cjs scripts/verifyPcnStandardDossierFlow.ts",
    "seed:pcn-standard-flow": "node ./scripts/run-pcn-tsx.cjs scripts/seedPcnStandardDossiers.ts",
    "reconcile:pcn-legacy": "node ./scripts/run-pcn-tsx.cjs scripts/reconcilePcnLegacyCollections.ts",
    "migrate:pcn-identifiers": "node ./scripts/run-pcn-tsx.cjs scripts/migratePcnIdentifiers.ts",
    "reconcile:pcn-orphan-results": "node ./scripts/run-pcn-tsx.cjs scripts/reconcilePcnOrphanResults.ts",
    "backup:daily": "node ./scripts/run-pcn-tsx.cjs scripts/run-pcn-daily-backup.ts",
    "migrate:storage": "tsx scripts/migrateKqtnImagesToSupabaseStorage.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
